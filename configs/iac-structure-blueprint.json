      "organizing-projects", "stacks", "projects", "structure", "directories"
    ],
    "opentofu_modules": [
      "modules", "develop", "structure", "composition", "patterns"
    ],
    "patterns_and_conventions": [
      "pattern", "convention", "standard", "guideline", "recommendation"
    ],
    "file_organization": [
      "files", "directories", "folder", "structure", "layout", "hierarchy"
